# LoRaWAN Network Server configuration (The Things Network v3)
TTN_API_KEY=your-ttn-api-key-here
TTN_APP_ID=your-application-id
TTN_TENANT_ID=ttn          # e.g. "ttn" for The Things Network community
TTN_BASE_URL=https://eu1.cloud.thethings.network

# MQTT configuration (for real-time uplink messages)
MQTT_HOST=eu1.cloud.thethings.network
MQTT_PORT=8883
MQTT_USERNAME=your-application-id@ttn
MQTT_PASSWORD=your-ttn-api-key-here
MQTT_USE_TLS=true

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
